{
  "name": "@glitchr/flowjs",
  "version": "1.3.1",
  "description": "Navigation without page loads, sticky scroll effects, scroll stops, sortable lists, AJAX channels, cookies and consent - one library, one module per feature",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./navigation": "./src/navigation.js",
    "./sticky": "./src/sticky.js",
    "./stops": "./src/stops.js",
    "./sortable": "./src/sortable.js",
    "./ajaxer": "./src/ajaxer.js",
    "./cookie": "./src/cookie.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "access": "public",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchr-studio/flowjs.git"
  },
  "author": "Marco Meyer <marco.meyer@glitchr.io>",
  "license": "MIT",
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "homepage": "https://github.com/glitchr-studio/flowjs#readme",
  "bugs": {
    "url": "https://github.com/glitchr-studio/flowjs/issues"
  }
}
